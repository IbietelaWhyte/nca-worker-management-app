# Local development credentials. COMMITTED ON PURPOSE.
#
# Every Supabase value here is the CLI's fixed local key: the same on every machine running
# `supabase start`, and worthless anywhere else. Tracking them is what lets a fresh clone
# run `just db-start && just dev` with no setup at all, and lets `just test` work without
# direnv.
#
# Read because APP_ENV is not "production". Real environment variables still win over this
# file, so exporting one in your shell overrides a line here without editing it.

APP_ENV=development

# The local stack, from `just db-env`.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
SUPABASE_SECRET_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# Placeholders. Nothing local should reach Twilio, and these credentials cannot: a send
# fails loudly instead of quietly texting a real volunteer from somebody's laptop. The
# number is Twilio's own test number.
TWILIO_ACCOUNT_SID=local-placeholder
TWILIO_AUTH_TOKEN=local-placeholder
TWILIO_FROM_NUMBER=+15005550006

SECRET_KEY=local-development-only
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO
