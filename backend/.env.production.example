# Production credentials. Copy to backend/.env.production, which is gitignored.
#
# Only needed to run the API locally against production — set APP_ENV=production in .envrc
# and this file is read instead of .env.development. The deployment itself needs no file:
# Railway sets these in its dashboard, and real environment variables win over any file.

APP_ENV=production

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

SECRET_KEY=
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# The one setting a deployment must not forget: it is the base of every SMS link, and its
# default is localhost. Settings refuses to start on a localhost URL when APP_ENV=production.
FRONTEND_URL=https://nca-worker-management-app.vercel.app

LOG_LEVEL=INFO

# Request concurrency / DB pooling. request_thread_pool_size must stay <= db_max_connections.
DB_MAX_CONNECTIONS=24
DB_MAX_KEEPALIVE_CONNECTIONS=12
DB_POOL_TIMEOUT=10.0
REQUEST_THREAD_POOL_SIZE=20

# Availability cut-off: how many days before a date it stops accepting answers.
# 0 closes only dates already past; 7 means next Sunday locks this Sunday.
AVAILABILITY_NOTICE_DAYS=0

# Fine-grained token, this repo, Issues: read and write. Prefixed deliberately — a bare
# GITHUB_TOKEN would override the gh CLI's own credentials in every shell opened here.
FEEDBACK_GITHUB_TOKEN=
FEEDBACK_GITHUB_REPO=IbietelaWhyte/nca-worker-management-app
