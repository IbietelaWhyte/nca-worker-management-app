# Copy to supabase/.env (gitignored) and fill in. Read by scripts/auth_email.py
# (`just smtp-apply` / `just smtp-env`). The Supabase CLI also loads this file for the
# env(...) values in config.toml. See docs/smtp-setup.md.

# Which provider Supabase sends invite and password-reset emails through: gmail or resend.
EMAIL_PROVIDER=gmail

# The name shown as the sender, beside whichever address the provider sends from.
EMAIL_SENDER_NAME="NCA Worker Management"

# --- Gmail (current) ---
# The mailbox the mail is sent as, and a 16-character App Password for it (not its password).
GMAIL_SMTP_USER=you@gmail.com
GMAIL_APP_PASSWORD=

# --- Resend (once the church domain is verified; see docs/church-onboarding.md) ---
# A sending-only API key (re_...) and an address on the verified domain.
RESEND_API_KEY=
RESEND_SENDER_EMAIL=no-reply@notify.example.org

# --- Supabase Management API (only `just smtp-apply` needs these) ---
# The project ref is the subdomain of the project URL; the token is a personal access token
# from https://supabase.com/dashboard/account/tokens.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
