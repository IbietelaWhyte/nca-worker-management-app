# Production values live in the Vercel dashboard, not here. This file is only for building
# or previewing the production bundle locally: copy to frontend/.env.production, which is
# gitignored and which `npm run build` reads.
#
# To point the dev server at production instead, use frontend/.env.development.local —
# ignored by the stock *.local rule and higher priority than .env.development.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=
