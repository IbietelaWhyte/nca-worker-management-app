# Local development. COMMITTED ON PURPOSE — see backend/.env.development.
#
# Loaded because `npm run dev` is Vite mode `development`. No flag sets that; it is Vite's
# default for the dev server, exactly as `npm run build` defaults to `production`.
#
# This must point at the same Supabase as the backend. The frontend signs in here and the
# backend verifies the resulting token against that project's JWKS, so a mismatched pair
# 401s every request.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
VITE_API_BASE_URL=http://localhost:8000/api/v1
