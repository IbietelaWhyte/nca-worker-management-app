# Copy to .envrc, then run `direnv allow`.
#
# This file holds one setting and no credentials. APP_ENV chooses which credentials file
# the backend reads — backend/.env.development or backend/.env.production — so it is the
# one thing that cannot itself live in one.
#
# You do not need this file to work locally. Unset, or anything other than "production",
# means development, and backend/.env.development is committed and ready to go. Set it to
# production only when you deliberately want a local API talking to the live database.
#
#   export APP_ENV="production"
#
export APP_ENV="development"
